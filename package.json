{
  "name": "psl-scaffold",
  "version": "1.0.0",
  "description": "A monorepo for the psl-scaffold project.",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,json}\"",
    "prepare": "husky",
    "report:issues": "node scripts/generate-issues-report.js",
    "antigravity": "node scripts/antigravity.js",
    "mcp:sync": "node scripts/sync-mcp.js",
    "mcp:replace": "node scripts/sync-mcp.js --replace"
  },
  "keywords": [],
  "author": "Purrfect Soft <info@purrfectsoft.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/node": "^20.14.10",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3"
  }
}
